# ---------------------------------------------------------------------------
# WorkBridge environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# Comma separated list of allowed browser origins for cross-origin API calls.
# Leave empty to allow same-origin only (recommended when the Node server also
# serves the frontend, which is the default deployment shape).
CORS_ORIGINS=

# Secret used to sign the session cookie value. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Session lifetime
SESSION_ABSOLUTE_HOURS=168
SESSION_IDLE_HOURS=12

# Password hashing cost (bcrypt rounds). 12 is a sane production default.
BCRYPT_ROUNDS=12

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# ---------------------------------------------------------------------------
# Data storage
# ---------------------------------------------------------------------------
# Directory for the runtime JSON database and the audit log. On ephemeral
# hosts (Render free tier, Heroku, plain containers) point this at a mounted
# persistent disk, otherwise all data is lost on redeploy.
DATA_DIR=./backend/data

# Directory for uploaded documents. Same ephemeral-filesystem warning applies.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Set to "true" to load the demo dataset (demo jobs/users/cases) when the
# runtime database is first created. Keep "false" for any public deployment.
SEED_DEMO_DATA=true

# Password given to the demo accounts when SEED_DEMO_DATA=true.
# Ignored unless demo seeding runs. Never set this on a public deployment.
DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Initial administrator (provisioned on first boot only; no public admin signup)
# ---------------------------------------------------------------------------
# If both are set and no Admin exists yet, this account is created once.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator

# ---------------------------------------------------------------------------
# AI assistant provider
# ---------------------------------------------------------------------------
# anthropic = live LLM replies. none = deterministic retrieval-only fallback.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MAX_TOKENS=1024
AI_EFFORT=low

# Per-user AI chat rate limit
AI_RATE_WINDOW_MINUTES=5
AI_RATE_MAX=20
